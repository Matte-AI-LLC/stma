# Server
PORT=3000
# Public origin of this deployment; used in OAuth redirects, invite links and MCP snippets
BASE_URL=http://localhost:3000
# NODE_ENV=production

# Database — required in production. When unset, an embedded PGlite database
# is used for local development (stored under .data/pglite).
# DATABASE_URL=postgres://user:pass@host:5432/stma
# Self-host without Postgres (single instance, persist the data dir with a volume):
# EMBEDDED_DB=1

# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
# Callback URL must be: {BASE_URL}/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Customer-facing ClickUp OAuth app (Settings → Apps → Create new app)
# Callback URL must be: {BASE_URL}/auth/clickup/callback
# CLICKUP_CLIENT_ID=
# CLICKUP_CLIENT_SECRET=

# Force-enable the passwordless dev login form (auto-enabled outside
# production when GitHub OAuth is not configured). NEVER enable in production.
# AUTH_DEV_MODE=1

# Local username+password accounts are on by default; AUTH_LOCAL=0 disables them.
# AUTH_LOCAL=1
# SIGNUPS_OPEN=0 stops new local account creation (existing users still sign in).
# SIGNUPS_OPEN=1

# Invite-only signup without closing it entirely: a code from this list is
# required to create an account. Comma separated, `code:label` to name a cohort
# in the log — the label is logged, the code never is. Unset, signup is
# unchanged. Use long, random codes; one shared code serves a whole group and is
# not consumed when somebody signs up.
# SIGNUP_ACCESS_CODES=a-long-random-code:first-wave,another-long-code:second-wave

# Lift every plan ceiling and switch every feature on, whatever a workspace's
# plan says. For running a hosted instance that is not selling anything yet:
# metering a beta only produces refusals nobody can pay their way out of. The
# instance stays hosted in every other respect, and unsetting this restores the
# plan matrix with no data to unwind.
# BETA_UNMETERED=1

# Where a person writes when the product goes wrong: the signed-out footer, the
# account page and the password-changed email all offer it. Unset here means
# nothing offers a support door, which is the honest default for an instance
# whose operator has not said where mail should go. The hosted service defaults
# to its own address; yours should be yours.
# SUPPORT_EMAIL=support@example.com

# SESSION_TTL_DAYS=30

# Retention: snapshots older than this are purged (0 disables).
# SNAPSHOT_RETENTION_DAYS=90
# Resolved debug sessions older than this are purged. 0 (default) keeps the
# searchable archive forever.
# SESSION_RETENTION_DAYS=0

# Agent presence: active runs become stale if their CLI/adapter stops sending
# heartbeats. Work claims are leased and renewed on every heartbeat.
# AGENT_STALE_MINUTES=3
# AGENT_CLAIM_LEASE_MINUTES=5
# Optional self-hosted integration encryption. Keep these values outside the database and repository.
# STMA_INTEGRATION_KEYS={"key-version":"<64 random hex characters>"}
# STMA_INTEGRATION_ACTIVE_KEY=key-version
# STMA_INTEGRATION_REQUIRE_ENCRYPTION=1
# Supply key material through a secret manager. Do not paste real keys into documentation.
